// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USTA
  FEHLE
}

enum ProjectStatus {
  GOZLEMEDE
  AKTIV
  DAYANDIRILIB
  TAMAMLANDI
  PASSIV
}

enum SupplyType {
  MATERIALLI
  ISCILIK
}

enum LogStatus {
  OPEN
  CLOSED
}

model Worker {
  id            String   @id @default(uuid())
  full_name     String
  role          Role     @default(FEHLE)
  phone         String   @unique
  password_hash String?
  pin_hash      String?
  daily_wage    Decimal  @default(0) @db.Decimal(10, 2)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  daily_logs_as_usta DailyLog[]         @relation("UstaDailyLogs")
  advances           Advance[]
  salary_settlements SalarySettlement[]
  audit_logs         AuditLog[]

  @@map("workers")
}

model WorkType {
  id               String   @id @default(uuid())
  name             String
  daily_norm_m2    Decimal  @db.Decimal(10, 2)
  default_price_m2 Decimal  @db.Decimal(10, 2)
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  project_stages ProjectStage[]

  @@map("work_types")
}

model Project {
  id             String        @id @default(uuid())
  name           String
  address        String
  client_name    String
  client_phone   String
  magic_token    String        @unique
  status         ProjectStatus @default(GOZLEMEDE)
  pause_reason   String?
  supply_type    SupplyType    @default(MATERIALLI)
  material_brand String?
  price_per_m2   Decimal       @db.Decimal(10, 2)
  total_amount   Decimal       @db.Decimal(12, 2)
  warranty_years Int           @default(5)
  otp_code       String?
  completed_at   DateTime?     @db.Timestamptz
  created_at     DateTime      @default(now()) @db.Timestamptz
  updated_at     DateTime      @updatedAt @db.Timestamptz

  stages         ProjectStage[]
  daily_logs     DailyLog[]
  materials      ProjectMaterial[]

  @@map("projects")
}

model ProjectStage {
  id           String   @id @default(uuid())
  project_id   String
  work_type_id String
  stage_name   String
  target_m2    Decimal  @db.Decimal(10, 2)
  completed_m2 Decimal  @default(0) @db.Decimal(10, 2)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  project   Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  work_type WorkType   @relation(fields: [work_type_id], references: [id])
  daily_logs DailyLog[]

  @@map("project_stages")
}

model DailyLog {
  id                String    @id @default(uuid())
  project_id        String
  usta_id           String
  helper_ids        String[]  @default([])
  work_date         DateTime  @db.Date
  morning_media_url String?
  morning_time      String?
  evening_media_url String?
  evening_time      String?
  stage_id          String?
  done_m2           Decimal   @default(0) @db.Decimal(10, 2)
  material_note     String?
  is_below_norm     Boolean   @default(false)
  status            LogStatus @default(OPEN)
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @updatedAt @db.Timestamptz

  project Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  usta    Worker        @relation("UstaDailyLogs", fields: [usta_id], references: [id])
  stage   ProjectStage? @relation(fields: [stage_id], references: [id])

  @@map("daily_logs")
}

model Advance {
  id         String   @id @default(uuid())
  worker_id  String
  amount     Decimal  @db.Decimal(10, 2)
  given_date DateTime @db.Date
  note       String?
  created_by String?
  created_at DateTime @default(now()) @db.Timestamptz

  worker Worker @relation(fields: [worker_id], references: [id], onDelete: Cascade)

  @@map("advances")
}

model SalarySettlement {
  id             String   @id @default(uuid())
  worker_id      String
  period_start   DateTime @db.Date
  period_end     DateTime @db.Date
  worked_days    Int
  gross_salary   Decimal  @db.Decimal(10, 2)
  total_advances Decimal  @db.Decimal(10, 2)
  net_paid       Decimal  @db.Decimal(10, 2)
  paid_at        DateTime @default(now()) @db.Timestamptz

  worker Worker @relation(fields: [worker_id], references: [id], onDelete: Cascade)

  @@map("salary_settlements")
}

model ProjectMaterial {
  id         String   @id @default(uuid())
  project_id String
  item_name  String
  quantity   Decimal  @db.Decimal(10, 2)
  unit_cost  Decimal  @db.Decimal(10, 2)
  total_cost Decimal  @db.Decimal(10, 2)
  added_at   DateTime @default(now()) @db.Timestamptz

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("project_materials")
}

model AuditLog {
  id           String   @id @default(uuid())
  actor_id     String?
  action       String
  target_table String
  target_id    String?
  details      Json?
  created_at   DateTime @default(now()) @db.Timestamptz

  actor Worker? @relation(fields: [actor_id], references: [id])

  @@map("audit_logs")
}
